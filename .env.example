# CoinGecko API
COINGECKO_API_KEY=your_coingecko_api_key_here

# Binance API
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Etherscan API
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Solscan API (Solana blockchain)
SOLSCAN_API_KEY=your_solscan_api_key_here

# DefiLlama API (no key required for public data)
DEFILLAMA_API_URL=https://api.llama.fi

# 1inch API (DEX aggregator)
ONEINCH_API_KEY=your_oneinch_api_key_here

# 0x API (DEX swap data)
ZEX_API_KEY=your_zex_api_key_here

# Dune Analytics (optional, for custom queries)
DUNE_API_KEY=your_dune_api_key_here

# Configuration
ANALYSIS_INTERVAL_MINUTES=60
MIN_MARKET_CAP_USD=1000000
MIN_VOLUME_USD=500000
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
ALERT_WEBHOOK_URL=your_webhook_url_here
